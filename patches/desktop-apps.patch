diff --git a/macos/ONLYOFFICE/main.mm b/macos/ONLYOFFICE/main.mm
index c058ab4..5311284 100644
--- a/macos/ONLYOFFICE/main.mm
+++ b/macos/ONLYOFFICE/main.mm
@@ -94,6 +94,32 @@ int main(int argc, const char * argv[]) {
     // setup editor fonts directory
     std::vector<std::wstring> fontsDirectories;
     fontsDirectories.push_back([[resourcePath stringByAppendingPathComponent:@"login/fonts"] stdwstring]);
+
+    CUserSettings * userSettings = appManager->GetUserSettings();
+    NSString * configuredFontsDir = [[NSString stringWithstdwstring:userSettings->Get(L"extra-fonts-folder")]
+        stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    delete userSettings;
+
+    auto appendValidFontDir = [&](NSString * candidate) {
+        NSString * trimmed = [candidate stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+        if (trimmed.length == 0) return NO;
+        NSString * expanded = [trimmed stringByExpandingTildeInPath];
+        BOOL isDir = NO;
+        if ([[NSFileManager defaultManager] fileExistsAtPath:expanded isDirectory:&isDir] && isDir &&
+            [[NSFileManager defaultManager] isReadableFileAtPath:expanded]) {
+            fontsDirectories.push_back([expanded stdwstring]);
+            return YES;
+        }
+        return NO;
+    };
+
+    if (configuredFontsDir.length > 0 && !appendValidFontDir(configuredFontsDir)) {
+        NSArray<NSString *> * parts = [configuredFontsDir componentsSeparatedByCharactersInSet:
+            [NSCharacterSet characterSetWithCharactersInString:@";\n\r"]];
+        for (NSString * part in parts) {
+            appendValidFontDir(part);
+        }
+    }
     appManager->m_oSettings.additional_fonts_folder = fontsDirectories;
     
     NSString * error_page = [resourcePath stringByAppendingPathComponent:@"login/noconnect.html"];
