+static std::wstring GetLanguagePart(const std::wstring& sLocale)
+{
+	std::wstring sLanguage = sLocale.substr(0, sLocale.find_first_of(L"-_"));
+	NSStringExt::ToLower(sLanguage);
+	return sLanguage;
+}
+
+// the lang param can be a bare ("zh") or synthetic ("zh-ZH") code, match it to an existing locale folder by language
+static std::wstring GetEmptyTemplatesLocale(const std::wstring& sEmptyDir, const std::wstring& sLang)
+{
+	if (!sLang.empty() && NSDirectory::Exists(sEmptyDir + sLang))
+		return sLang;
+
+	std::wstring sLanguage = GetLanguagePart(sLang);
+	// en-EN support (documents have en-GB and en-US)
+	if (sLanguage.empty() || L"en" == sLanguage)
+		return L"en-US";
+
+	std::wstring sPreferred = sLanguage + L"-" + sLanguage;
+	NSStringExt::ToUpper(sPreferred);
+
+	std::vector<std::wstring> arCandidates;
+	std::vector<std::wstring> arDirs = NSDirectory::GetDirectories(sEmptyDir);
+	for (const std::wstring& sDir : arDirs)
+	{
+		std::wstring sName = NSFile::GetFileName(sDir);
+		if (GetLanguagePart(sName) != sLanguage)
+			continue;
+
+		std::wstring sNameUpper = sName;
+		NSStringExt::ToUpper(sNameUpper);
+		if (sNameUpper == sPreferred)
+			return sName;
+
+		arCandidates.push_back(sName);
+	}
+
+	if (arCandidates.empty())
+		return L"en-US";
+
+	std::sort(arCandidates.begin(), arCandidates.end());
+	return arCandidates[0];
+}
